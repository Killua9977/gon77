# Storage
# Local example: ./data
# Railway example with mounted volume: /data
DATA_DIR=./data

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Capital.com
CAPITAL_API_KEY=
CAPITAL_LOGIN=
CAPITAL_PASSWORD=
CAPITAL_DEMO=true

# Risk
INITIAL_EQUITY=1000.0
RISK_PERCENT=1.0
DAILY_LOSS_LIMIT_PCT=3.0
MAX_AUTH_RETRIES=5
NEWS_BUFFER_MINS=30

# US500 ORB
ORB_TP1_MULT=1.0
ORB_TP2_MULT=2.0
ORB_MIN_RANGE=5.0
ORB_MAX_RANGE=60.0
ORB_BUFFER=0.5
PRE_MARKET_BIAS=0.003

# EURUSD / GBPUSD ARB
ARB_TP1_MULT=1.0
ARB_TP2_MULT=2.0
ARB_MIN_RANGE=0.0010
ARB_MAX_RANGE=0.0060
ARB_BUFFER=0.0005
ARB_ADX_MIN=18.0

# USDJPY PDB
PDB_TP1_MULT=1.0
PDB_TP2_MULT=2.0
PDB_BUFFER=0.05
PDB_MIN_RANGE=0.30
PDB_MAX_RANGE=2.00

# Runtime
SCAN_INTERVAL=10
HEARTBEAT_SECS=1800
